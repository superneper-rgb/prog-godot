 "vertexShader": "varying vec2 vUv; varying vec3 vN; varying vec3 vV;\nvoid main() { vUv = uv; vec4 mv = modelViewMatrix * vec4(position, 1.0); vN = normalize(normalMatrix * normal); vV = normalize(-mv.xyz); gl_Position = projectionMatrix * mv; }",
 "fragmentShader": "uniform float uTime, uAlpha, uRim, uFill; uniform vec3 uColor, uHot; uniform sampler2D uNoise; varying vec2 vUv; varying vec3 vN; varying vec3 vV;\nvoid main() {\n  float f = abs(dot(normalize(vN), normalize(vV)));\n  float n = texture2D(uNoise, vec2(vUv.x * 3.0 + uTime * 0.25, vUv.y * 2.0 - uTime * 0.9)).r;\n  float rim = pow(1.0 - f, 2.6) * uRim, a = (rim + uFill * (0.4 + n) * f) * uAlpha;\n  gl_FragColor = vec4(mix(uColor, uHot, clamp(rim * 0.8 + uFill * f * n, 0.0, 1.0)), a);\n}",
