 "type": "ShaderMaterial",
 "vertexShader": "varying vec2 vUv; varying vec3 vN; varying vec3 vV;\nvoid main() { vUv = uv; vec4 mv = modelViewMatrix * vec4(position, 1.0); vN = normalize(normalMatrix * normal); vV = normalize(-mv.xyz); gl_Position = projectionMatrix * mv; }",
 "fragmentShader": "uniform float uTime, uAlpha, uLen, uSpiral, uRim, uFill; uniform vec3 uColor, uHot; uniform sampler2D uNoise; varying vec2 vUv; varying vec3 vN; varying vec3 vV;\nvoid main() {\n  float f = abs(dot(normalize(vN), normalize(vV))), along = vUv.y * uLen;\n  float n = texture2D(uNoise, vec2(vUv.x * 2.0 + uTime * 0.4, along * 0.18 - uTime * 2.6)).r;\n  float n2 = texture2D(uNoise, vec2(vUv.x * 3.0 - uTime * 0.7, along * 0.45 - uTime * 6.0)).r;\n  float body = uFill * smoothstep(0.0, 0.75, f) + uRim * pow(1.0 - f, 2.0);\n  float spi = uSpiral * smoothstep(0.55, 1.0, sin(vUv.x * 12.566 + along * 2.2 - uTime * 30.0)) * (0.5 + n2);\n  float a = clamp(body * (0.55 + 0.9 * n) + spi, 0.0, 1.6) * uAlpha;\n  vec3 col = mix(uColor, uHot, clamp(body * n + spi * 0.6, 0.0, 1.0));\n  gl_FragColor = vec4(col, a);\n}",
