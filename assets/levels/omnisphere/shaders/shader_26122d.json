{
 "name": "shader_26122d",
 "type": "ShaderMaterial",
 "vertexShader": "\n  attribute float aSize, aAlpha, aRot; attribute vec3 aCol; uniform float uScale; varying float vA, vR; varying vec3 vC;\n  #include <fog_pars_vertex>\n  void main() { vec4 mvPosition = modelViewMatrix * vec4(position, 1.); gl_Position = projectionMatrix * mvPosition; float d = -mvPosition.z;\n    gl_PointSize = clamp(aSize * uScale / max(d, .1), 0., 900.); vA = aAlpha * smoothstep(.8, 5., d) * step(1., gl_PointSize); vR = aRot; vC = aCol;\n    #include <fog_vertex>\n  }",
 "fragmentShader": "\n  uniform sampler2D uMap; varying float vA, vR; varying vec3 vC;\n  #include <fog_pars_fragment>\n  void main() { vec2 u = gl_PointCoord - .5; float c = cos(vR), s = sin(vR); u = vec2(c * u.x - s * u.y, s * u.x + c * u.y) + .5;\n    vec4 t = texture2D(uMap, u); gl_FragColor = vec4(vC * t.rgb, t.a * vA); if (gl_FragColor.a < .003) discard;\n    #include <fog_fragment>\n  }",
